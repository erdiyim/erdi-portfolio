#!/bin/sh
# app.js veya style.css commit'e giriyorsa min dosyalarını yeniden üretip commit'e ekler.
# Kurulum: npm install (prepare betiği core.hooksPath'i .githooks olarak ayarlar)

degisti=0
for dosya in $(git diff --cached --name-only); do
    case "$dosya" in
        app.js|style.css) degisti=1 ;;
    esac
done

if [ "$degisti" = 1 ]; then
    echo "pre-commit: app.min.js ve style.min.css yeniden üretiliyor..."
    npm run minify --silent || {
        echo "pre-commit: minify başarısız, commit durduruldu." >&2
        exit 1
    }
    git add app.min.js style.min.css
fi
