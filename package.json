{
  "name": "erdi-portfolio",
  "private": true,
  "description": "Erdi Öcal kişisel portfolyo sitesi",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "minify": "npm run minify:js && npm run minify:css",
    "minify:js": "terser app.js -o app.min.js --compress --mangle",
    "minify:css": "csso style.css -o style.min.css",
    "minify:check": "npm run minify && git diff --exit-code -- app.min.js style.min.css",
    "start": "serve -l 3000 --no-clipboard ."
  },
  "devDependencies": {
    "csso-cli": "^4.0.2",
    "serve": "^14.2.4",
    "terser": "^5.36.0"
  }
}
